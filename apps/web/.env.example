# Copy to .env.local. Values come from `pnpm exec supabase status`.
# Staging values live in wrangler.jsonc (public) and `wrangler secret` (secret): docs/STAGING.md
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never prefix with NEXT_PUBLIC_. Local: SECRET_KEY from `supabase status`.
SUPABASE_SECRET_KEY=
# 1 = activate new businesses immediately (development and staging only; ignored in production)
AUTO_APPROVE_BUSINESSES=1
# "Contact Us" on the portal opens a mail to this address
NEXT_PUBLIC_CONTACT_EMAIL=support@momentbooking.com
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
