# Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app (public only).
# Use your Mac's Wi-Fi IP (ipconfig getifaddr en0), not 127.0.0.1, so a physical
# phone can reach local Supabase. Key comes from `pnpm exec supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Dev-only auth bypass for testing screens without SMS / email. Set to 1 in
# .env.local to turn it on: any phone number or email and any 6-digit code sign
# in as the local dev user (+92 300 1234567, a test_otp number in
# supabase/config.toml); 000000 shows "Wrong verification code". Ignored in
# release builds (__DEV__ is false). Restart Metro after changing it.
# Once the dev user has finished sign up, later sign-ins skip that screen. To see
# it again, reset the dev user in local Supabase (Studio SQL editor, or psql):
#   update public.profile_private set first_name = null, last_name = null,
#     date_of_birth = null, sign_up_completed_at = null where phone = '+923001234567';
EXPO_PUBLIC_AUTH_BYPASS=0
