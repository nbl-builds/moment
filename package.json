{
  "name": "moment",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "web": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @moment/shared test",
    "test:integration": "pnpm --filter @moment/shared test:integration",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --schema public,private --level warning",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/types/database.types.ts && prettier --write --log-level warn packages/shared/src/types/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "supabase": "^2"
  }
}
